# Supabase — créer un projet gratuit sur https://supabase.com puis copier ce
# fichier vers .env et remplir (Settings > API du dashboard Supabase).
# La clé "anon" est publique par design (protégée par Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
